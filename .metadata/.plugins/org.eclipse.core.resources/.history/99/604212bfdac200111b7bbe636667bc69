void printTime(){
	 printNumber(bcdToDec(i2cRead(0x02)));
	 sendUartChar(':');
	 printNumber(bcdToDec(i2cRead(0x01)));
	 sendUartChar(':');
	 printNumber(bcdToDec(i2cRead(0x00)));
	 sendUartChar('\r');
     sendUartChar('\n'); // newline for readability
}

event_t getEvent(void){
	if (buttonPressed){
		buttonPressed = 0;
		return EV_CLICK;
	}
	else if(encoderDelta >= 2){
		encoderDelta-=2;
		return EV_CW;
	}
	else if (encoderDelta <= 2){
		encoderDelta+=2;
		return EV_CCW;
	}
	else{
		return EV_NONE;
	}
}
