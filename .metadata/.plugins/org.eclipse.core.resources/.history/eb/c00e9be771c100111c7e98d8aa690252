#include <stdio.h>
#include <stdint.h>

#define RCC_APB1    (*(volatile uint32_t*)0x40023840)
#define RCC_AHB1    (*(volatile uint32_t*)0x40023830)
#define GPIOA_MODER (*(volatile uint32_t*)0x40020000)
#define GPIOA_AFLR  (*(volatile uint32_t*)0x40020020)
#define USART_SR    (*(volatile uint32_t*)0x40004400)
#define USART_DR    (*(volatile uint32_t*)0x40004404)
#define USART_BRR   (*(volatile uint32_t*)0x40004408)
#define USART_CR1   (*(volatile uint32_t*)0x4000440C)

void usartInit(){
	// Clock
	RCC_APB1 |= (1 << 17); // enable uart2 clock
	RCC_AHB1 |= (1 <<  0); // enable gpioA clock
	//set Mode
	GPIOA_MODER &= ~(3 << 4); // clear bits
	GPIOA_MODER |= (2 << 4); // set to AF Mode
	GPIOA_AFLR &= ~(0xF << 8); // clear bits
	GPIOA_AFLR |= (0x7 << 8); // specify AF Mode
	// Uart config
	USART_CR1 |= (1 << 13); // enable uart
	USART_BRR = 1667;
	USART_CR1 |= (1 << 3); // enable TX
}

void sendUartChar(char c){
	while(!(USART_SR & (1 << 7)));
	USART_DR = c;
}


void printNumber(uint8_t num){
    uint8_t tens = num / 10;
    uint8_t ones = num % 10;

    sendUartChar(tens + '0');   // convert tens digit to character
    sendUartChar(ones + '0');   // convert ones digit to character
}

